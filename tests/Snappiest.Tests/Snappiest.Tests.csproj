<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test naming and assertion style differ from library code -->
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1835;CA1861;CA2007;CA2201</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.16" />
    <!-- Reference implementation for interop and migration tests -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Snappiest\Snappiest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\testdata\*" LinkBase="TestData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
